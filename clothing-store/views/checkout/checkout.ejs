<%- include('../partials/head') %>
<%- include('../partials/navbar') %>
<%- include('../partials/flash') %>

<main class="mx-auto max-w-6xl px-4 py-10">
  <h1 class="brand text-4xl">Checkout</h1>
  <p class="text-sm text-stone-600 mt-2">Payment method: <span class="font-semibold text-stone-900">Cash on Delivery</span></p>

  <div class="mt-8 grid gap-8 lg:grid-cols-3">
    <form action="/checkout" method="POST" class="lg:col-span-2 rounded-2xl border border-stone-200 bg-white p-6 space-y-4">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div>
        <label class="label">Full Name</label>
        <input class="input" type="text" name="customerName" required>
      </div>
      <div class="grid gap-4 sm:grid-cols-2">
        <div>
          <label class="label">Phone</label>
          <input class="input" type="text" name="phone" required>
        </div>
        <div>
          <label class="label">Email (optional)</label>
          <input class="input" type="email" name="email">
        </div>
      </div>
      <div>
        <label class="label">Address</label>
        <textarea class="input min-h-24" name="address" required></textarea>
      </div>
      <div class="grid gap-4 sm:grid-cols-2">
        <div>
          <label class="label">City</label>
          <input class="input" type="text" name="city" required>
        </div>
        <div>
          <label class="label">Postal Code</label>
          <input class="input" type="text" name="postalCode">
        </div>
      </div>
      <button class="btn-primary" type="submit">Place COD Order</button>
    </form>

    <aside class="rounded-2xl border border-stone-200 bg-white p-6 h-fit">
      <h2 class="font-semibold">Order Summary</h2>
      <div class="mt-4 space-y-3 text-sm">
        <% cartData.items.forEach((item) => { %>
          <div class="flex justify-between gap-3">
            <span class="text-stone-600"><%= item.product.name %> x <%= item.quantity %></span>
            <span>₹<%= item.lineTotal.toLocaleString('en-IN') %></span>
          </div>
        <% }) %>
      </div>
      <div class="mt-4 border-t border-stone-200 pt-4 text-sm space-y-2">
        <div class="flex justify-between"><span>Subtotal</span><span>₹<%= cartData.subtotal.toLocaleString('en-IN') %></span></div>
        <div class="flex justify-between"><span>Shipping</span><span>₹<%= cartData.shippingFee.toLocaleString('en-IN') %></span></div>
        <div class="flex justify-between font-semibold text-base"><span>Total</span><span>₹<%= cartData.total.toLocaleString('en-IN') %></span></div>
      </div>
    </aside>
  </div>
</main>

<%- include('../partials/footer') %>
