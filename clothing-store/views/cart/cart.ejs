<%- include('../partials/head') %>
<%- include('../partials/navbar') %>
<%- include('../partials/flash') %>

<main class="mx-auto max-w-6xl px-4 py-10">
  <h1 class="brand text-4xl">Your Cart</h1>

  <% if (!cartData.items.length) { %>
    <div class="mt-8 rounded-2xl border border-dashed border-stone-300 p-10 text-center bg-white">
      <p class="text-stone-600">Your cart is empty.</p>
      <a href="/shop" class="btn-primary inline-block mt-5">Continue Shopping</a>
    </div>
  <% } else { %>
    <div class="mt-8 grid gap-8 lg:grid-cols-3">
      <div class="lg:col-span-2 space-y-4">
        <% cartData.items.forEach((item) => { %>
          <article class="rounded-2xl border border-stone-200 bg-white p-4 flex gap-4">
            <img src="<%= item.product.imageUrl %>" alt="<%= item.product.name %>" class="h-28 w-24 rounded-xl object-cover"/>
            <div class="flex-1">
              <h2 class="font-semibold"><%= item.product.name %></h2>
              <p class="text-sm text-stone-500 mt-1">₹<%= item.product.price.toLocaleString('en-IN') %></p>
              <div class="mt-3 flex items-center gap-2">
                <form action="/cart/update" method="POST" class="flex items-center gap-2">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <input type="hidden" name="productId" value="<%= item.product._id %>">
                  <input type="number" name="quantity" value="<%= item.quantity %>" min="0" max="10" class="w-16 rounded-md border border-stone-300 px-2 py-1 text-sm">
                  <button class="text-sm rounded-md border border-stone-300 px-3 py-1 hover:bg-stone-100">Update</button>
                </form>
                <form action="/cart/remove" method="POST">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <input type="hidden" name="productId" value="<%= item.product._id %>">
                  <button class="text-sm text-red-600 hover:text-red-700">Remove</button>
                </form>
              </div>
            </div>
            <div class="font-medium text-amber-800">₹<%= item.lineTotal.toLocaleString('en-IN') %></div>
          </article>
        <% }) %>
      </div>

      <aside class="rounded-2xl border border-stone-200 bg-white p-6 h-fit">
        <h3 class="font-semibold text-lg">Order Summary</h3>
        <div class="mt-4 space-y-2 text-sm text-stone-600">
          <div class="flex justify-between"><span>Subtotal</span><span>₹<%= cartData.subtotal.toLocaleString('en-IN') %></span></div>
          <div class="flex justify-between"><span>Shipping</span><span>₹<%= cartData.shippingFee.toLocaleString('en-IN') %></span></div>
          <div class="flex justify-between border-t border-stone-200 pt-2 text-base font-semibold text-stone-900"><span>Total</span><span>₹<%= cartData.total.toLocaleString('en-IN') %></span></div>
        </div>
        <a href="/checkout" class="btn-primary mt-6 block text-center">Proceed to Checkout</a>
      </aside>
    </div>
  <% } %>
</main>

<%- include('../partials/footer') %>
