<%- include('../partials/head') %>
<%- include('../partials/navbar') %>
<%- include('../partials/flash') %>

<main class="mx-auto max-w-6xl px-4 py-10">
  <div class="grid gap-8 lg:grid-cols-2">
    <img src="<%= product.imageUrl %>" alt="<%= product.name %>" class="w-full rounded-3xl object-cover h-[520px]"/>
    <div>
      <p class="text-xs uppercase tracking-[0.2em] text-stone-500"><%= product.category %></p>
      <h1 class="brand text-4xl mt-3"><%= product.name %></h1>
      <p class="mt-4 text-stone-700 leading-relaxed"><%= product.description %></p>
      <p class="mt-6 text-3xl font-semibold text-amber-800">₹<%= product.price.toLocaleString('en-IN') %></p>
      <p class="mt-2 text-sm text-stone-500">Available stock: <%= product.inStock %></p>

      <form action="/cart/add" method="POST" class="mt-8 flex items-center gap-4">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="productId" value="<%= product._id %>">
        <input type="number" name="quantity" value="1" min="1" max="10" class="w-20 rounded-lg border border-stone-300 px-3 py-2">
        <button class="btn-primary" type="submit">Add to Cart</button>
      </form>
    </div>
  </div>

  <% if (relatedProducts.length) { %>
    <section class="mt-14">
      <h2 class="brand text-3xl mb-6">You may also like</h2>
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        <% relatedProducts.forEach((item) => { %>
          <a href="/product/<%= item.slug %>" class="rounded-2xl border border-stone-200 bg-white p-4 hover:shadow-md transition">
            <img src="<%= item.imageUrl %>" alt="<%= item.name %>" class="h-56 w-full rounded-xl object-cover"/>
            <h3 class="mt-3 font-medium"><%= item.name %></h3>
            <p class="text-sm text-amber-800">₹<%= item.price.toLocaleString('en-IN') %></p>
          </a>
        <% }) %>
      </div>
    </section>
  <% } %>
</main>

<%- include('../partials/footer') %>
