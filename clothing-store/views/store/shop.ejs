<%- include('../partials/head') %>
<%- include('../partials/navbar') %>
<%- include('../partials/flash') %>

<main class="mx-auto max-w-6xl px-4 py-10">
  <h1 class="brand text-4xl text-stone-900">Shop All Products</h1>
  <p class="mt-2 text-stone-600">Minimal, elegant & premium pieces curated for every moment.</p>

  <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
    <% products.forEach((product) => { %>
      <article class="product-card">
        <a href="/product/<%= product.slug %>"><img src="<%= product.imageUrl %>" alt="<%= product.name %>" class="h-72 w-full rounded-2xl object-cover"/></a>
        <div class="mt-4">
          <h2 class="text-lg font-semibold"><a href="/product/<%= product.slug %>"><%= product.name %></a></h2>
          <p class="text-sm text-stone-600 mt-2"><%= product.description.slice(0, 90) %>...</p>
          <div class="mt-4 flex items-center justify-between">
            <span class="font-semibold text-amber-800">₹<%= product.price.toLocaleString('en-IN') %></span>
            <form action="/cart/add" method="POST">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <input type="hidden" name="productId" value="<%= product._id %>">
              <button class="btn-primary" type="submit">Add</button>
            </form>
          </div>
        </div>
      </article>
    <% }) %>
  </div>
</main>

<%- include('../partials/footer') %>
