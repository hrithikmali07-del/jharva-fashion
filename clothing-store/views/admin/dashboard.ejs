<%- include('../partials/head') %>
<%- include('../partials/navbar') %>
<%- include('../partials/flash') %>

<main class="mx-auto max-w-6xl px-4 py-10 space-y-10">
  <div class="flex items-center justify-between">
    <h1 class="brand text-4xl">Admin Dashboard</h1>
    <form action="/admin/logout" method="POST">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button class="rounded-full border border-stone-300 px-4 py-2 text-sm hover:bg-stone-100">Logout</button>
    </form>
  </div>

  <section class="rounded-3xl border border-stone-200 bg-white p-6">
    <h2 class="text-2xl brand mb-5">Add Product</h2>
    <form action="/admin/products" method="POST" class="grid gap-4 md:grid-cols-2">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div><label class="label">Name</label><input class="input" type="text" name="name" required></div>
      <div><label class="label">Price</label><input class="input" type="number" name="price" min="0" step="1" required></div>
      <div class="md:col-span-2"><label class="label">Description</label><textarea class="input min-h-24" name="description" required></textarea></div>
      <div><label class="label">Image URL</label><input class="input" type="url" name="imageUrl" required></div>
      <div><label class="label">Category</label><input class="input" type="text" name="category" value="Kurti"></div>
      <div><label class="label">Stock</label><input class="input" type="number" name="inStock" min="0" value="10" required></div>
      <div class="flex items-end"><label class="inline-flex items-center gap-2 text-sm"><input type="checkbox" name="featured"> Featured Product</label></div>
      <div class="md:col-span-2"><button class="btn-primary" type="submit">Create Product</button></div>
    </form>
  </section>

  <section class="rounded-3xl border border-stone-200 bg-white p-6">
    <h2 class="text-2xl brand mb-5">Manage Products</h2>
    <div class="space-y-5">
      <% products.forEach((product) => { %>
        <article class="rounded-2xl border border-stone-200 p-4">
          <form action="/admin/products/<%= product._id %>?_method=PUT" method="POST" class="grid gap-3 md:grid-cols-2">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <input class="input" type="text" name="name" value="<%= product.name %>" required>
            <input class="input" type="number" name="price" value="<%= product.price %>" min="0" required>
            <textarea class="input md:col-span-2 min-h-20" name="description" required><%= product.description %></textarea>
            <input class="input" type="url" name="imageUrl" value="<%= product.imageUrl %>" required>
            <input class="input" type="text" name="category" value="<%= product.category %>">
            <input class="input" type="number" name="inStock" value="<%= product.inStock %>" min="0">
            <label class="inline-flex items-center gap-2 text-sm"><input type="checkbox" name="featured" <%= product.featured ? 'checked' : '' %>> Featured</label>
            <div class="md:col-span-2 flex gap-3">
              <button class="btn-primary" type="submit">Save</button>
          </form>
          <form action="/admin/products/<%= product._id %>?_method=DELETE" method="POST" class="inline">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button class="rounded-full border border-red-200 px-4 py-2 text-sm text-red-600 hover:bg-red-50" type="submit">Delete</button>
          </form>
            </div>
        </article>
      <% }) %>
    </div>
  </section>

  <section class="rounded-3xl border border-stone-200 bg-white p-6">
    <h2 class="text-2xl brand mb-5">Orders</h2>
    <div class="space-y-4">
      <% orders.forEach((order) => { %>
        <article class="rounded-2xl border border-stone-200 p-4">
          <div class="flex flex-wrap items-center justify-between gap-3">
            <div>
              <p class="font-semibold"><%= order.customerName %> · <%= order.phone %></p>
              <p class="text-sm text-stone-600"><%= order.address %>, <%= order.city %></p>
              <p class="text-sm text-stone-500">COD · ₹<%= order.totalAmount.toLocaleString('en-IN') %></p>
            </div>
            <div class="text-right">
              <span class="text-xs rounded-full px-3 py-1 <%= order.status === 'Shipped' ? 'bg-emerald-100 text-emerald-700' : 'bg-amber-100 text-amber-700' %>"><%= order.status %></span>
              <% if (order.status !== 'Shipped') { %>
                <form class="mt-2" action="/admin/orders/<%= order._id %>/ship?_method=PATCH" method="POST">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <button class="rounded-full border border-stone-300 px-4 py-1.5 text-sm hover:bg-stone-100" type="submit">Mark Shipped</button>
                </form>
              <% } %>
            </div>
          </div>
          <ul class="mt-3 text-sm text-stone-600 list-disc pl-5">
            <% order.items.forEach((item) => { %>
              <li><%= item.name %> × <%= item.quantity %></li>
            <% }) %>
          </ul>
        </article>
      <% }) %>
    </div>
  </section>
</main>

<%- include('../partials/footer') %>
